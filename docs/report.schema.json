{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trust-ai-governance/treval/report.schema.json",
  "title": "treval self-contained maturity report bundle (EV-R1)",
  "description": "The UI's stable consumption seam: one file inlining the report, the registry needed to render + join, and the measurements. Derived from the frozen MaturityReport/Measurement dataclasses + REPORT_JSON_SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_kind",
    "evidence_basis",
    "citable",
    "citable_blockers",
    "registry_fingerprint",
    "provenance",
    "report",
    "registry",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "citable": {
      "description": "EV-CITE 件一: may these numbers leave the room? true iff citable_blockers is empty. Disclosure, not refusal — the bundle is emitted either way. NOT about whether a result looks good: an honest 'unmet' is citable; only report-wide provenance failures block.",
      "type": "boolean"
    },
    "citable_blockers": {
      "description": "EV-CITE 件一: report-wide reasons a number can't be cited (broken chain / unpinned / missing segment hash / non-chain-anchored evidence). Each entry NAMES A FIX. Empty ⇔ citable.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_kind": {
      "description": "R1: what was evaluated. raw_model = bare-model baseline · gateway = governed (WAL-anchored) · moderation_api = third-party moderation API. Default gateway.",
      "type": "string",
      "enum": [
        "raw_model",
        "gateway",
        "moderation_api"
      ]
    },
    "evidence_basis": {
      "description": "R1 (裁定 A): evidence strength, DERIVED from target_kind, never stored independently — gateway→wal_anchored / raw_model→harness_observed / moderation_api→self_reported. self_reported is the weakest tier (vendor self-report, NOT reproducible); it must never borrow verifiable-audit wording.",
      "type": "string",
      "enum": [
        "wal_anchored",
        "harness_observed",
        "self_reported"
      ]
    },
    "registry_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "report": {
      "$ref": "#/definitions/report"
    },
    "registry": {
      "$ref": "#/definitions/registry"
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/measurement"
      }
    },
    "provenance": {
      "description": "EV-PIN run stamp: the frozen window + WAL segment bytes behind these numbers. null for a pre-EV-PIN bundle (honestly absent, never fabricated). `pinned:false` or null ⇒ a moving-window snapshot that external documents must not cite.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "data_source": {
          "description": "What kind of data this is, declared positively by the producer. `measured` = read from a real WAL. `synthetic_demo` = fabricated for demonstration; every number is invented and the UI must say so on the page. Absent on bundles produced before this field existed — treat as `measured`, which is what they were.",
          "type": "string",
          "enum": [
            "measured",
            "synthetic_demo"
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "window": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "window_semantics": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "wal_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_window": {
          "description": "EV-CITE C12: the half-open [min, max+1) window the records ACTUALLY occupy. When a pinned window caught nothing (record_count==0), this is the UNFILTERED span so the citability blocker can hand the operator a window to re-pin. null ⇒ no records to point at.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "wal_segments": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "first",
            "last",
            "count",
            "sha256"
          ],
          "properties": {
            "first": {
              "type": "string"
            },
            "last": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "level_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^L[1-5]$"
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "seq",
        "request_id"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "seq": {
          "type": [
            "integer",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "objective_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_id",
        "kind",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "objective_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "measured",
            "attested"
          ]
        },
        "status": {
          "enum": [
            "met",
            "unmet",
            "insufficient_data",
            "unverified_evidence"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence_ref"
          }
        }
      }
    },
    "dimension_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "measured_ceiling",
        "attested_ceiling",
        "awarded_level",
        "measured_state",
        "measured_breakpoint",
        "measured_gap",
        "objectives",
        "gaps"
      ],
      "properties": {
        "dimension": {
          "type": "string"
        },
        "measured_ceiling": {
          "$ref": "#/definitions/level_or_null"
        },
        "attested_ceiling": {
          "$ref": "#/definitions/level_or_null"
        },
        "awarded_level": {
          "$ref": "#/definitions/level_or_null"
        },
        "measured_state": {
          "type": "string",
          "enum": [
            "certified",
            "below_floor",
            "evidence_unverified",
            "blocked_no_data",
            "not_measured"
          ]
        },
        "measured_breakpoint": {
          "$ref": "#/definitions/level_or_null"
        },
        "measured_gap": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/objective_result"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "window",
        "dimensions",
        "integrity_summary",
        "verification_basis"
      ],
      "properties": {
        "tenant_id": {
          "type": "string"
        },
        "window": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dimension_report"
          }
        },
        "integrity_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verified",
            "unverified",
            "broken"
          ],
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            },
            "broken": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "verification_basis": {
          "enum": [
            "wal",
            "index",
            "hybrid"
          ]
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicator_id",
        "dimension",
        "value",
        "unit",
        "sample_size",
        "subject",
        "notes",
        "integrity",
        "availability",
        "interval_basis",
        "citation_form",
        "evidence_refs"
      ],
      "properties": {
        "indicator_id": {
          "type": "string"
        },
        "interval_basis": {
          "description": "EV-CIGATE §1.5 mechanism class, declared by the indicator and carried with the measurement so citation_form words 'no interval' correctly: 'sampled' (detector → interval), 'total_function' (default-deny → residual in coverage), 'census' (full enumeration → no sampling uncertainty), or '' (detector/non-rate, unspecified).",
          "type": "string",
          "enum": [
            "",
            "sampled",
            "total_function",
            "census"
          ]
        },
        "citation_form": {
          "description": "EV-CITE 件一 §1.4: a paste-whole口径 for this measurement — a rate carries n + 95% interval, a census says '普查 n/n' (no interval), and a not-citable value is prefixed '🔴 NOT CITABLE —'. Present on the self-contained (delivery) bundle only.",
          "type": "string"
        },
        "dimension": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "subject": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "integrity": {
          "enum": [
            "verified",
            "unverified",
            "broken"
          ]
        },
        "availability": {
          "description": "EV-FWD: can this indicator be MEASURED on this target? DERIVED from (target_kind × the indicator's evidence_requirement), never stored independently. measured = a value exists (its trust tier is evidence_basis, a SEPARATE axis) · n/a_needs_gateway = architecturally absent on a bare model (needs the governed decision/WAL path) · n/a_self_reported = absent on a moderation API (no WAL; not 'needs gateway' but 'vendor self-report, no such dimension'). n/a is NOT insufficient_data — it will never exist in this mode, not 'this run missed it'.",
          "enum": [
            "measured",
            "n/a_needs_gateway",
            "n/a_self_reported"
          ]
        },
        "ci_low": {
          "description": "EV-CIGATE §7-A: Wilson 95% lower bound WHEN this value is a binomial proportion; null for a non-rate/deterministic-census indicator. A `ci_low >= τ` objective over null raises (never silently grades).",
          "type": ["number", "null"]
        },
        "ci_high": {
          "description": "EV-CIGATE §7-A: Wilson 95% upper bound (paired with ci_low). null when the indicator is not a binomial proportion.",
          "type": ["number", "null"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence_ref"
          }
        }
      }
    },
    "registry_objective": {
      "type": "object",
      "required": [
        "id",
        "statement_zh",
        "kind",
        "indicator_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement_zh": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "measured",
            "attested"
          ]
        },
        "indicator_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "posture_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "satisfied_when": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "registry_dimension": {
      "type": "object",
      "required": [
        "id",
        "title_en",
        "title_zh",
        "levels"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title_en": {
          "type": "string"
        },
        "title_zh": {
          "type": "string"
        },
        "levels": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/registry_objective"
            }
          }
        }
      }
    },
    "registry": {
      "description": "The inlined DimensionRegistry (EV-W0 serialize_registry shape) the UI needs for the grid structure + the objective->indicator_id value join.",
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "levels_meta",
        "dimensions"
      ],
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "levels_meta": {
          "type": "array"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/registry_dimension"
          }
        }
      }
    }
  }
}
